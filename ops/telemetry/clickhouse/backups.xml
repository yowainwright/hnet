<clickhouse>
  <storage_configuration>
    <disks>
      <telemetry_backups>
        <type>local</type>
        <path>/var/lib/clickhouse/backups/</path>
      </telemetry_backups>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>telemetry_backups</allowed_disk>
    <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
  </backups>
</clickhouse>
