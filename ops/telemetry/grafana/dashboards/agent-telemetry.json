          "queryType": "timeSeries",
          "rawSql": "SELECT toStartOfInterval(events.time, INTERVAL 5 minute) AS time, client, count() AS calls\nFROM otel.agent_calls AS events\nWHERE $__timeFilter(events.time)\nGROUP BY time, client ORDER BY time",
