          "format": 0,
          "queryType": "timeSeries",
          "rawSql": "SELECT toStartOfInterval(events.time, INTERVAL 5 minute) AS time, client, if(model = '', 'unknown', model) AS model, count() AS calls\nFROM otel.agent_calls AS events\nWHERE $__timeFilter(events.time)\nGROUP BY time, client, model ORDER BY time",
