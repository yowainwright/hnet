            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeSeries",
          "rawSql": "SELECT toStartOfInterval(TimeUnix, INTERVAL 5 minute) AS time, ServiceName AS client, coalesce(nullIf(Attributes['gen_ai.token.type'], ''), nullIf(Attributes['token_type'], ''), nullIf(Attributes['type'], ''), 'total') AS token_type, sum(Sum) AS tokens\nFROM otel.otel_metrics_histogram\nWHERE positionCaseInsensitive(MetricName, 'token') > 0 AND $__timeFilter(TimeUnix)\nGROUP BY time, client, token_type ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Tokens over time",
      "type": "timeseries"
    },
