          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT session, any(client) AS client, any(host) AS host, min(time) AS started, max(time) AS last_seen, count() AS events\nFROM otel.agent_events\nWHERE session != '' AND $__timeFilter(time)\nGROUP BY session ORDER BY last_seen DESC LIMIT 100",
          "refId": "A"
        }
