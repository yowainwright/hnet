          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeSeries",
          "rawSql": "SELECT toStartOfInterval(events.time, INTERVAL 5 minute) AS time, client, model, sum(input_tokens) AS input_tokens, sum(output_tokens) AS output_tokens, sum(cached_input_tokens) AS cached_input_tokens\nFROM otel.agent_usage AS events\nWHERE $__timeFilter(events.time)\nGROUP BY time, client, model ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Tokens over time",
      "type": "timeseries",
      "description": "Completed-response usage. Input includes cache reads and writes; cached input is a subset. Output includes reasoning where reported. Metric snapshots are excluded."
